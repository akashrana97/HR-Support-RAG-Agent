APP_NAME="HR Support RAG Copilot"
APP_ENV=development
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hr-support-rag
PINECONE_NAMESPACE=company-hr-kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ADMIN_API_KEY=replace-with-a-strong-secret
# Search Tavily only after private HR evidence is weak.
ENABLE_WEB_FALLBACK=true
TAVILY_API_KEY=
TOP_K=4
MAX_RETRIES=1

# Optional LangSmith observability. Enable only when ready to send trace data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-support-rag-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
